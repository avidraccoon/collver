include "std.collver"

alias command "python3 collver.py com " end

// Takes argc and argv from the command line and converts it to a vector of strings.
// This function leaks a lot of memory. But it works so......
proc arg_to_str int ptr -> str do
    memory args sizeof(ptr) end
    memory cur_pointer sizeof(ptr) end
    "" (str->ptr) strcpy args !ptr
    cur_pointer !ptr
    cur_pointer @ptr sizeof(ptr) + cur_pointer !ptr 1 - // Skip the first argument (the program name)
    while dup 0 != do // while there are still arguments to process
        args @ptr (ptr->str) cur_pointer @ptr @ptr (ptr->str) 
        strconcat " " strconcat (str->ptr) args !ptr
        cur_pointer @ptr sizeof(ptr) + cur_pointer !ptr
        1 -
    end drop
    args @ptr (ptr->str)
end

proc main int ptr -> int do
    arg_to_str command [str,str->int,int] swap [int,int->str,str] strconcat (str->ptr) sys_system
    drop
    0
end
