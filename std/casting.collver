extern cast_str_to_str str -> str end

alias (int->int) cast_int_to_int end
alias (int->ptr) cast_int_to_ptr end
alias (int->str) cast_int_to_str end
alias (ptr->int) cast_ptr_to_int end
alias (ptr->ptr) cast_ptr_to_ptr end
alias (ptr->str) cast_ptr_to_str end
alias (str->int) cast_str_to_int end
alias (str->ptr) cast_str_to_ptr end
alias (str->str) cast_str_to_str end
alias (ptr->ptr[int]) cast_ptr_to_ptr end
alias (ptr[int]->ptr) cast_ptr_to_ptr end
alias (str->ptr[int]) cast_str_to_ptr end
alias (ptr[int]->str) cast_ptr_to_str end

