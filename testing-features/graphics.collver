include "std.collver"

proc main int ptr -> int do
  drop drop

  gfx_clear drop

  255 200 40 gfx_set_rgb drop
  "Collver graphics demo\n" puts
  gfx_reset_style drop

  "RGB text samples:\n" puts
  255 80 80 gfx_set_rgb drop
  "  red sample\n" puts
  80 220 120 gfx_set_rgb drop
  "  green sample\n" puts
  90 140 255 gfx_set_rgb drop
  "  blue sample\n" puts
  gfx_reset_style drop

  "Gradient bar:\n" puts
  memory i sizeof(int) end
  0 i !64
  while i @64 48 < do
    i @64 5 * 255 &
    180
    255 i @64 4 * - 255 &
    gfx_set_rgb drop
    "#" puts
    i inc64
  end
  gfx_reset_style drop
  "\nDone.\n" puts

  gfx_reset_style drop
  0
end
