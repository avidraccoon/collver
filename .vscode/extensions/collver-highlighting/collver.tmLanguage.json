{
    "$schema": "raw.githubusercontent.com",
    "name": "Collver",
    "scopeName": "source.collver",
    "########patterns": [
        { "include": "#comments" },
        { "include": "#strings" },

        { "include": "#ptr_generic" },
        { "include": "#struct_field_access" },
        { "include": "#struct_definition" },

        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#operators" },
        { "include": "#numbers" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                { "name": "comment.line.double-slash.collver", "match": "//.*$" }
            ]
        },

        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.collver",
                    "begin": "\"",
                    "end": "\""
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.collver",
                    "match": "\\b(int|str|byte|ptr)\\b"
                },
                {
                    "name": "entity.name.type.struct.collver",
                    "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "ptr_generic": {
            "name": "meta.type.pointer.collver",
            "begin": "\\bptr\\[",
            "beginCaptures": {
                "0": { "name": "storage.type.primitive.collver" }
            },
            "end": "\\]",
            "patterns": [
                { "include": "#ptr_generic" },
                { "include": "#types" }
            ]
        },
        "struct_definition": {
            "name": "meta.struct.definition.collver",
            "begin": "\\bstruct\\s+([A-Z][A-Za-z0-9_]*)",
            "beginCaptures": {
                "1": { "name": "entity.name.type.struct.collver" }
            },
            "end": "\\bend\\b",
            "patterns": [
                {
                    "name": "meta.struct.field.collver",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s+(int|str|byte|ptr|ptr\\[[^\\]]+\\]|[A-Z][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "variable.other.member.definition.collver" },
                        "2": { "name": "storage.type.collver" }
                    }
                },
                { "include": "#ptr_generic" },
                { "include": "#types" }
            ]
        },
        "struct_field_access": {
            "patterns": [
                {
                    "name": "meta.struct.access.collver",
                    "match": "@([A-Z][A-Za-z0-9_]*)\\.([a-zA-Z0-9_]+)",
                    "captures": {
                        "1": { "name": "entity.name.type.struct.collver" },
                        "2": { "name": "variable.other.member.collver" }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.collver",
                    "match": "\\b(proc|extern|do|end|if|elif|else|while|memory|const|alias|include|struct)\\b"
                },
                {
                    "name": "entity.name.function.collver",
                    "match": "(?<=(proc|extern)\\s+)[a-zA-Z0-9_]+"
                },
                {
                    "name": "entity.name.constant.collver",
                    "match": "(?<=(alias|const)\\s+)[^\\s]+"
                },
                {
                    "name": "variable.other.memory.collver",
                    "match": "(?<=\\bmemory\\s+)[a-zA-Z0-9_]+"
                },

                {
                    "name": "constant.other.sizeof.collver",
                    "match": "sizeof\\([^\\)]+\\)"
                },

                {
                    "name": "keyword.control.program.collver",
                    "match": "\\b(exit|get_errno)\\b"
                },
                {
                    "name": "keyword.control.stack.collver",
                    "match": "\\b(dup|2dup|drop|swap|over)\\b"
                },
                {
                    "name": "keyword.control.inputoutput.collver",
                    "match": "\\b(sys_read|sys_write|sys_open|sys_close|puts|eputs|fd_readline|fd_puts|readline|putn|eputn|print|eprint)\\b"
                },
                {
                    "name": "keyword.control.string.collver",
                    "match": "\\b(strlen|strcpy|strcmp|strconcat_d|strconcat|streq|itos|stoi|fd_to_str|fp_to_str)\\b"
                },
                {
                    "name": "keyword.control.logical.collver",
                    "match": "\\b(lnorm|lnot|2norm|nland|land|nlor|lor|nlxor|lxor|btos)\\b"
                },
                {
                    "name": "keyword.control.memory.collver",
                    "match": "\\b(alloc|free|inc64|dec64|memcpy|ptrto|bptrto)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.memory.collver",
                    "match": "(@|!|\\?)(64|32|16|8|int|ptr|byte|str)"
                },
                {
                    "name": "keyword.operator.logical.collver",
                    "match": "(\\+|\\-|\\*|\\/|=|!=|<|>|<=|>=|&&|&|\\^|\\||\\|\\|)"
                },
                {
                    "name": "keyword.operator.arithmetic.collver",
                    "match": "(%|>>|<<)"
                },
                {
                    "name": "keyword.operator.typing.collver",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.casting.collver",
                    "match": "\\([^\\s]+->[^\\s]+\\)"
                },
                {
                    "name": "keyword.operator.casting.collver",
                    "match": "\\[[^\\]]+->[^\\]]+\\]"
                }
            ]
        },
        "numbers": {
            "patterns": [
                { "name": "constant.numeric.collver", "match": "\\b[0-9]+\\b" },
                {
                    "name": "constant.language.sys.collver",
                    "match": "\\b(FD_STDIN|FD_STDOUT|FD_STDERR|O_RDONLY|O_WRONLY|O_RDWR|O_CLOEXEC|O_CREAT|O_DIRECTORY|O_EXCL|O_NOCTTY|O_NOFOLLOW|O_TRUNC)\\b"
                }
            ]
        }
    }
}