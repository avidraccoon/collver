{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Collver",
  "scopeName": "source.collver",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },

    { "include": "#procDefinition" },
    { "include": "#externDefinition" },
    { "include": "#structDefinition" },

    { "include": "#sizeof" },
    { "include": "#structFieldConsts" },
    { "include": "#ptrTyped" },

    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },

    { "include": "#intrinsics" },
    { "include": "#memoryOps" },
    { "include": "#procCallHeuristic" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.collver",
          "begin": "//",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.collver" }
          },
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.collver",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.collver" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.collver" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.collver",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "procDefinition": {
      "patterns": [
        {
          "name": "meta.definition.proc.collver",
          "match": "\\b(proc)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.collver" },
            "2": { "name": "entity.name.function.collver" }
          }
        }
      ]
    },

    "externDefinition": {
      "patterns": [
        {
          "name": "meta.definition.extern.collver",
          "match": "\\b(extern)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.collver" },
            "2": { "name": "entity.name.function.collver" }
          }
        }
      ]
    },

    "structDefinition": {
      "patterns": [
        {
          "name": "meta.definition.struct.collver",
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.collver" },
            "2": { "name": "entity.name.type.struct.collver" }
          }
        }
      ]
    },

    "sizeof": {
      "patterns": [
        {
          "name": "meta.sizeof.collver",
          "match": "\\b(sizeof)\\(([A-Za-z_][A-Za-z0-9_]*)\\)",
          "captures": {
            "1": { "name": "support.function.sizeof.collver" },
            "2": { "name": "entity.name.type.struct.collver" }
          }
        }
      ]
    },

    "ptrTyped": {
      "patterns": [
        {
          "name": "meta.type.ptr.collver",
          "match": "\\bptr\\[([A-Za-z_][A-Za-z0-9_]*)\\]",
          "captures": {
            "0": { "name": "storage.type.pointer.collver" },
            "1": { "name": "entity.name.type.struct.collver" }
          }
        }
      ]
    },

    "structFieldConsts": {
      "patterns": [
        {
          "name": "meta.structfieldconst.collver",
          "match": "@([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "0": { "name": "variable.other.member.collver" },
            "1": { "name": "entity.name.type.struct.collver" },
            "2": { "name": "variable.other.property.collver" }
          }
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.collver",
          "match": "\\b(proc|extern|memory|if|elif|else|while|do|end|struct|include|const|alias|as)\\b"
        },
        {
          "name": "keyword.operator.arrow.collver",
          "match": "->"
        },
        {
          "name": "keyword.other.here.collver",
          "match": "\\bhere\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "storage.type.collver",
          "match": "\\b(int|str|ptr|unknown)\\b"
        },
        {
          "name": "storage.type.pointer.collver",
          "match": "\\bptr\\[[^\\]]+\\]"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.collver",
          "match": "\\b-?\\d+\\b"
        }
      ]
    },

    "intrinsics": {
      "patterns": [
        {
          "name": "support.function.intrinsic.collver",
          "match": "\\bintrinsic_[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "memoryOps": {
      "patterns": [
        {
          "name": "keyword.operator.memory.collver",
          "match": "[@!](ptr|8|16|32|64)\\b"
        }
      ]
    },

    "procCallHeuristic": {
      "patterns": [
        {
          "name": "entity.name.function.call.collver",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b"
        }
      ]
    }
  }
}